# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# --- Database ---------------------------------------------------------
# Local MySQL:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce_etl
DB_USER=etl_user
DB_PASSWORD=change_me

# Cloud MySQL (Railway/Aiven/etc.) — replace the block above with the
# values your provider gives you, e.g.:
# DB_HOST=containers-us-west-1.railway.app
# DB_PORT=6543
# DB_USER=root
# DB_PASSWORD=<provider-generated password>
# DB_NAME=railway

# --- Data sources -------------------------------------------------------
CSV_DATA_DIR=./data
FAKESTORE_API_BASE=https://fakestoreapi.com

# --- Pipeline behaviour ---------------------------------------------------
CSV_CHUNK_SIZE=5000
API_MAX_RETRIES=3
API_RETRY_BACKOFF_SECONDS=2
API_TIMEOUT_SECONDS=10

# --- Logging -----------------------------------------------------------
LOG_DIR=./logs
LOG_LEVEL=INFO
